# ============================================================
# Filmografia — variáveis de ambiente
# Copie este arquivo para .env (local) e configure na Vercel (produção)
# ============================================================

# PostgreSQL do Neon (free tier) — https://neon.tech
# Use a string "pooled" (host com -pooler) para runtime/serverless (Vercel).
# Formato: postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&connection_timeout=10"

# Conexão direta (host SEM -pooler) usada apenas pelo Prisma CLI para migrações.
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Tamanho máximo do pool de conexões por função serverless (padrão 3).
PG_POOL_MAX="3"

# TMDB (obrigatória) — crie gratuitamente em https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# OMDb (opcional) — enriquece com nota oficial do IMDb, prêmios e classificação.
# Crie gratuitamente em https://www.omdbapi.com/apikey.aspx (1.000 requisições/dia)
OMDB_API_KEY=""

# Segredo usado para assinar o cookie de sessão JWT (OBRIGATÓRIO, mínimo 16 caracteres).
# Gere um valor aleatório longo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: em produção (Vercel) use um segredo DIFERENTE do usado localmente.
AUTH_SECRET=""
